{
  "uid": "patrol-logs",
  "title": "道路巡查 Demo — 服務監控",
  "tags": ["patrol", "loki"],
  "timezone": "Asia/Taipei",
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "container",
        "label": "服務",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": "label_values(container)",
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "current": {
          "text": ["All"],
          "value": ["$__all"]
        },
        "allValue": "patrol-.*"
      },
      {
        "name": "search",
        "label": "關鍵字",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        },
        "description": "篩選日誌內容；可填單號、帳號或 emoji 標記"
      }
    ]
  },
  "schemaVersion": 39,
  "version": 2,
  "panels": [
    {
      "type": "row",
      "title": "服務健康",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "stat",
      "title": "錯誤 (ERROR / 5xx)",
      "description": "任何服務寫出的錯誤層級日誌。持續大於 0 時，先看下方的「錯誤來自哪個服務」。",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({container=~\"$container\"} |~ \"(?i)error|❌\" [$__auto]))",
          "refId": "A",
          "queryType": "range"
        }
      ],
      "options": {
        "graphMode": "area",
        "colorMode": "background_solid",
        "textMode": "auto",
        "justifyMode": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 20
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
