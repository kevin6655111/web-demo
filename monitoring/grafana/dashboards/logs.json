        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (container) (count_over_time({container=~\"$container\"} |~ \"(?i)error|❌\" [$__auto]))",
          "refId": "A",
          "queryType": "range",
          "legendFormat": "{{container}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": ["sum", "max"]
