# ─────────────────────────────────────────────────────────────
# 所有機密都在這裡，開發與部署共用同一份。
#
#   cp .env.example .env && vi .env
#
# config/*.yaml 裡的 ${VAR} 佔位符會從這裡取值；
# 缺任何一個，後端會在啟動時列出「缺哪個變數、對應哪個設定路徑」然後中止。
# 這個檔案不進版控。
# ─────────────────────────────────────────────────────────────

# ─── 備援入口 ─────────────────────────────────────────────────
# 客戶端連不到主要 port 時的第二個入口（防火牆只放行特定 port 的環境）。
# 內容與主要入口完全相同。不設就只綁在 127.0.0.1，等於沒開。
# HTTP_ALT_PORT=8080

# ─── 郵件 (選填) ──────────────────────────────────────────────
# 未設定時進入記錄模式：郵件完整排入佇列並保存於 mail_jobs，
# 但不實際寄出。內容可在「郵件工作」介面檢視。
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@example.com

# ─── 推播 (選填) ──────────────────────────────────────────────
# Firebase 服務帳戶金鑰，以 base64 單行編碼：base64 -w0 service-account.json
# 未設定時進入記錄模式：查詢目標裝置並記錄內容，但不實際送出。
# FIREBASE_SERVICE_ACCOUNT_B64=

# ─── 資料庫 (PostgreSQL + PostGIS) ───────────────────────────
POSTGRES_USER=patrol
POSTGRES_PASSWORD=change-me-postgres

# ─── JWT 簽章金鑰 ─────────────────────────────────────────────
# 產生方式：openssl rand -hex 32
JWT_SECRET=change-me-openssl-rand-hex-32

# ─── 物件儲存 (MinIO) ─────────────────────────────────────────
MINIO_ROOT_USER=patrol-demo
MINIO_ROOT_PASSWORD=change-me-minio-at-least-8-chars

# ─── API 文件金鑰 ─────────────────────────────────────────────
# 文件分成「內部一份」與「對外一單位一份」，各自一把金鑰，可個別撤銷 ——
# 某一單位的連結外流時只換那一把，不必通知所有對接單位。
#
# 未設定(或少於 10 字元)的那一份文件會回 503。文件裡有完整的欄位結構與業務規則，
# 「預設開放」不是合理的預設值。
#
# 產生方式：openssl rand -hex 16
#
#   內部文件  /internal-docs?k=<DOCS_INTERNAL_KEY>
#   車機廠商  /api-docs/device?k=<DOCS_DEVICE_KEY>
#   行動應用  /api-docs/app?k=<DOCS_APP_KEY>
DOCS_INTERNAL_KEY=change-me-docs-internal-key
DOCS_DEVICE_KEY=change-me-docs-device-key
DOCS_APP_KEY=change-me-docs-app-key

# ─── 對外網域 (docker compose 用) ─────────────────────────────
DOMAIN=localhost

# ─── Grafana(日誌監控) ────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana

# 瀏覽器連得到的 MinIO 位址；簽名網址用它產生
# 對外部署時改成實際網域，例如 https://storage.example.com
MINIO_PUBLIC_URL=http://localhost:19000
